# =========================
# ToolBox 项目环境变量模板
# 使用方法：复制本文件为 .env，并填入对应值
# 注意：.env 已加入 .gitignore，真实密钥切勿提交到仓库
# =========================

# Supabase配置
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 加密配置
VITE_ENCRYPTION_KEY=your-encryption-key

# =========================
# 邮箱聚合插件 OAuth 密钥
# =========================

# Google OAuth (Gmail)
# 在 Google Cloud Console 创建 OAuth 2.0 客户端（应用类型：桌面应用）
# 凭据地址：https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft OAuth (Outlook) - 可选
# 在 Azure Portal 注册 Azure AD 应用（平台：移动和桌面应用程序，回跳 URI 启用 http://localhost）
OUTLOOK_OAUTH_CLIENT_ID=
OUTLOOK_OAUTH_CLIENT_SECRET=
