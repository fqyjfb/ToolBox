{
  "name": "toolbox",
  "private": true,
  "version": "3.1.3",
  "description": "ToolBox多功能工具包应用程序",
  "author": "ToolBox Team",
  "type": "commonjs",
  "engines": {
    "node": ">=20.x"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/generate-icon-data.cjs && vite",
    "dev:electron": "node scripts/generate-icon-data.cjs && vite --mode electron",
    "build": "node scripts/generate-icon-data.cjs && node scripts/generate-app-icon.cjs && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "node scripts/generate-icon-data.cjs && electron .",
    "electron:build": "node scripts/generate-icon-data.cjs && node scripts/generate-app-icon.cjs && node scripts/write-env-secrets.cjs && electron-builder --publish never",
    "postinstall": "electron-builder install-app-deps",
    "generate-icons": "node scripts/generate-icon-data.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1094.0",
    "@aws-sdk/s3-request-presigner": "^3.1094.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@open-file-viewer/core": "^0.1.33",
    "@open-file-viewer/react": "^0.1.33",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.100.10",
    "adm-zip": "^0.6.0",
    "chrono-node": "^2.10.2",
    "dompurify": "3.4.14",
    "electron-log": "^5.4.4",
    "follow-redirects": "^1.16.0",
    "imapflow": "^1.7.8",
    "koffi": "^3.3.4",
    "lucide-react": "^1.8.0",
    "mailparser": "^3.9.20",
    "markdown-it": "15.0.1",
    "markdown-it-footnote": "4.0.0",
    "node-notifier": "^10.0.1",
    "node-screenshots": "^0.2.8",
    "nodemailer": "^6.9.16",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "rapidocr-node": "^0.3.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "react-window": "^1.8.10",
    "rrule": "^2.8.1",
    "sql.js": "^1.12.0",
    "tyme4ts": "^1.5.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^1.8.8",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.27",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "lightningcss": "^1.33.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^5.4.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "@tanstack/react-query": "5.100.10",
      "pngjs": "^7.0.0"
    }
  },
  "build": {
    "appId": "com.toolbox.app",
    "productName": "ToolBox",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "public/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/react-router/**",
      "!node_modules/react-router-dom/**",
      "!node_modules/react-window/**",
      "!node_modules/scheduler/**",
      "!node_modules/@dnd-kit/**",
      "!node_modules/@tanstack/**",
      "!node_modules/@supabase/**",
      "!node_modules/lucide-react/**",
      "!node_modules/qrcode/**",
      "!node_modules/@open-file-viewer/**",
      "!node_modules/pdfjs-dist/**",
      "!node_modules/mermaid/**",
      "!node_modules/echarts/**",
      "!node_modules/three/**",
      "!node_modules/hls.js/**",
      "!node_modules/xlsx/**",
      "!node_modules/cytoscape/**",
      "!node_modules/cytoscape-fcose/**",
      "!node_modules/leaflet/**",
      "!node_modules/ag-psd/**",
      "!node_modules/@napi-rs/**",
      "!node_modules/@aiden0z/**",
      "!node_modules/docx-preview/**",
      "!node_modules/mammoth/**",
      "!node_modules/chrono-node/**",
      "!node_modules/codepage/**",
      "!node_modules/katex/**",
      "!node_modules/@mermaid-js/**",
      "!node_modules/es-toolkit/**",
      "!node_modules/heic2any/**",
      "!node_modules/zrender/**",
      "!node_modules/prismjs/**",
      "!node_modules/dompurify/**",
      "!node_modules/d3/**",
      "!node_modules/tyme4ts/**",
      "!node_modules/proj4/**",
      "!node_modules/shpjs/**",
      "!node_modules/lodash-es/**",
      "!node_modules/underscore/**",
      "!node_modules/pako/**",
      "!node_modules/jszip/**",
      "!node_modules/markdown-it/**",
      "!node_modules/markdown-it-footnote/**",
      "!node_modules/zustand/**",
      "!node_modules/dayjs/**",
      "!node_modules/pngjs/**",
      "!node_modules/sql.js/dist/*debug*",
      "!node_modules/sql.js/dist/*sql-asm*",
      "!node_modules/sql.js/dist/sql-wasm-browser*"
    ],
    "asarUnpack": [
      "node_modules/node-notifier/vendor/**",
      "node_modules/rapidocr-node/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/@img/sharp-win32-x64/**",
      "node_modules/node-screenshots/**",
      "node_modules/node-screenshots-*/**",
      "public/favicon.ico"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
