{
  "name": "toolbox",
  "private": true,
  "version": "2.8.1",
  "description": "ToolBox多功能工具包应用程序",
  "author": "ToolBox Team",
  "type": "commonjs",
  "engines": {
    "node": ">=20.x"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite --mode electron",
    "build": "node scripts/generate-icon-data.cjs && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "node scripts/generate-icon-data.cjs && electron .",
    "electron:build": "node scripts/generate-icon-data.cjs && electron-builder --publish never",
    "copy:vditor": "node scripts/copy-vditor-assets.cjs",
    "postinstall": "electron-builder install-app-deps && npm run copy:vditor",
    "generate-icons": "node scripts/generate-icon-data.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1094.0",
    "@aws-sdk/s3-request-presigner": "^3.1094.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@open-file-viewer/core": "^0.1.33",
    "@open-file-viewer/react": "^0.1.33",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.100.10",
    "adm-zip": "^0.6.0",
    "electron-log": "^5.4.4",
    "follow-redirects": "^1.16.0",
    "lucide-react": "^1.8.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "sql.js": "^1.12.0",
    "vditor": "^3.11.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.27",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "lightningcss": "^1.33.0",
    "node-gyp": "^12.3.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^5.4.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3"
    }
  },
  "build": {
    "appId": "com.toolbox.app",
    "productName": "ToolBox",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/favicon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
